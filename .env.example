# Copy to .env.local (never commit real values). Vercel: Project Settings -> Environment Variables.
# Both values are public by design (NEXT_PUBLIC_ = embedded into the browser bundle at build time).
# Never put a service_role / secret key here or anywhere in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-publishable-or-anon-key>
# There are no feature flags: Snapshot, portfolio copy/delete and manual age are always on.
